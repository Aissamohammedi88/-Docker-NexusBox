use std::os::unix::fs::PermissionsExt;
            meta.permissions().mode()
        };
        #[cfg(not(unix))]
        let mode: u32 = 0;

        global_hasher.update(rel.as_bytes());
        global_hasher.update(b":");
        global_hasher.update(file_hash.as_bytes());
        global_hasher.update(b"\n");

        total_files += 1;
        total_size += meta.len();

        files.push(FileEntry {
            path: rel,
            size: meta.len(),
            hash: file_hash,
            mtime,
            mode,
        });
    }

    files.sort_by(|a, b| a.path.cmp(&b.path));

    Ok(ScanResult {
        root: root.to_string_lossy().to_string(),
        total_files,
        total_dirs,
        total_size,
        global_hash: hex_encode(&global_hasher.finalize()),
        files,
    })
}

/// Diff entre deux répertoires
fn diff_dirs(old_root: &Path, new_root: &Path) -> Result<DiffResult, String> {
    let old_scan = scan_dir(old_root)?;
    let new_scan = scan_dir(new_root)?;

    let old_map: BTreeMap<String, String> = old_scan
        .files
        .into_iter()
        .map(|f| (f.path, f.hash))
        .collect();
    let new_map: BTreeMap<String, String> = new_scan
        .files
        .into_iter()
        .map(|f| (f.path, f.hash))
        .collect();

    let mut entries: Vec<DiffEntry> = Vec::new();
    let mut added: u64 = 0;
    let mut modified: u64 = 0;
    let mut deleted: u64 = 0;
    let mut unchanged: u64 = 0;

    // Fichiers nouveaux ou modifiés
    for (path, new_hash) in &new_map {
        match old_map.get(path) {
            None => {
                added += 1;
                entries.push(DiffEntry {
                    path: path.clone(),
                    status: "ADDED".to_string(),
                    old_hash: None,
                    new_hash: Some(new_hash.clone()),
                });
            }
            Some(old_hash) => {
                if old_hash != new_hash {
                    modified += 1;
                    entries.push(DiffEntry {
                        path: path.clone(),
                        status: "MODIFIED".to_string(),
                        old_hash: Some(old_hash.clone()),
                        new_hash: Some(new_hash.clone()),
                    });
                } else {
                    unchanged += 1;
                }
            }
        }
    }

    // Fichiers supprimés
    for (path, old_hash) in &old_map {
        if !new_map.contains_key(path) {
            deleted += 1;
            entries.push(DiffEntry {
                path: path.clone(),
                status: "DELETED".to_string(),
                old_hash: Some(old_hash.clone()),
                new_hash: None,
            });
        }
    }

    entries.sort_by(|a, b| a.path.cmp(&b.path));

    Ok(DiffResult {
        old_root: old_root.to_string_lossy().to_string(),
        new_root: new_root.to_string_lossy().to_string(),
        added,
        modified,
        deleted,
        unchanged,
        entries,
    })
}

/// Encode un hash en hexadécimal
fn hex_encode(bytes: &[u8]) -> String {
    let mut s = String::with_capacity(bytes.len() * 2);
    for b in bytes {
        s.push_str(&format!("{:02x}", b));
    }
    s
}
