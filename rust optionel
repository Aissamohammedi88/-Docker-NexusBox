#[derive(Serialize, Deserialize, Debug, Clone)]
struct FileEntry {
    path: String,
    size: u64,
    hash: String,
    mtime: u64,
    mode: u32,
}

#[derive(Serialize, Deserialize, Debug)]
struct ScanResult {
    root: String,
