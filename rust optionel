    old_hash: Option<String>,
    new_hash: Option<String>,
}

#[derive(Serialize, Deserialize, Debug)]
struct DiffResult {
    old_root: String,
    new_root: String,
    added: u64,
    modified: u64,
    deleted: u64,
    unchanged: u64,
    entries: Vec<DiffEntry>,
}

fn usage() {
    eprintln!("NEXUSBOX-HASH v{}", VERSION);
    eprintln!();
    eprintln!("Usage: nexusbox-hash <command> [args]");
    eprintln!();
    eprintln!("Commands:");
    eprintln!("  hash <dir>              Fast hash of directory");
    eprintln!("  scan <dir>              Full scan with metadata (JSON)");
    eprintln!("  diff <old> <new>        Compare two directories (JSON)");
    eprintln!("  compare <hash1> <hash2> Compare two hashes");
    eprintln!("  version                 Show version");
}

