printf "  ${G}layer tags${N}                        Lister les tags\n"
    echo ""
    printf "${BOLD}ARCHIVAGE${N}\n"
    printf "  ${G}layer pack${N} <box> <tag> [out]      Compresser (zstd)\n"
    echo ""
    printf "${BOLD}SYSTÈME${N}\n"
